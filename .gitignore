# Python virtual environments & bytecode
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Rust build artifacts
rust/**/target/

# Local secrets and environment
.env
infra/.env
*.local.env

# Editors / OS
.DS_Store
.idea/
.vscode/

# Airflow generated DAGs and pools (local to each user/environment)
dags/*
!dags/.gitkeep

# Source design-time dossiers (local agent scraping analyses)
ingestions/*
!ingestions/_fixture/
!ingestions/_fixture/**
!ingestions/_lanes/
!ingestions/_lanes/**
!ingestions/_template/
!ingestions/_template/**
!ingestions/.gitkeep

# Probe caches and temporary scraper data
**/.cache/
probes/.cache/
**/probes/.cache/

# Local execution logs and runtime data
logs/
*.log
airflow_logs/
scratch/
rustfs/
data/
*.db
*.sqlite3

# dbt local build artifacts
dbt/target/
dbt/dbt_packages/
dbt/logs/
